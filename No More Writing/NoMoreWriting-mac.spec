# -*- mode: python ; coding: utf-8 -*-
"""
PyInstaller spec for No More Writing — macOS .app bundle.

Build (must run ON macOS — PyInstaller does not cross-compile):
    pyinstaller --noconfirm NoMoreWriting-mac.spec

Output: dist/NoMoreWriting.app — a proper Mac bundle ready to be dragged into
/Applications or wrapped in a .dmg via make_release_dmg.py.

Why a separate spec from the Windows one:
- Different target_arch (universal2 vs default x86_64)
- BUNDLE block with Info.plist entries (mic / accessibility / LSUIElement)
- .icns icon instead of .ico
- No nvidia/* CUDA DLLs, no winsound, no Win32 VERSIONINFO resource
"""

from pathlib import Path
from PyInstaller.utils.hooks import collect_data_files, collect_submodules, collect_dynamic_libs

ROOT = Path(SPECPATH)


# --- Hidden imports ---------------------------------------------------------

hiddenimports = []
# whisper.cpp Python bindings — the Mac transcription backend
hiddenimports += collect_submodules("pywhispercpp")
hiddenimports += collect_submodules("sounddevice")
hiddenimports += ["pyperclip", "ollama", "pynput"]
hiddenimports += collect_submodules("PIL")
hiddenimports += ["customtkinter"]
hiddenimports += [
    "PySide6.QtCore", "PySide6.QtGui", "PySide6.QtWidgets",
]
# PyObjC bits used by overlay_qt._install_mac_topmost()
hiddenimports += ["AppKit", "objc", "Foundation"]


# --- Data files -------------------------------------------------------------

datas = []
# .icns icon — generated by make_release_dmg.py prior to running PyInstaller
datas += [("assets/icon.icns", "assets")]
# PNG icons stay too — main window uses them at runtime
for s in (16, 24, 32, 48, 64, 128, 256):
    datas += [(f"assets/icon_{s}.png", "assets")]
# the CLEAN default only (paths.ensure_user_config seeds the user's own config from it) — never the developer's config.json
datas += [("config.default.json", ".")]


# --- Binaries ---------------------------------------------------------------

binaries = []
# pywhispercpp ships a precompiled libwhisper.dylib in its package; PyInstaller's
# dynamic-libs collector finds it via the package metadata.
try:
    binaries += collect_dynamic_libs("pywhispercpp")
except Exception:
    pass


# --- Analysis ---------------------------------------------------------------

a = Analysis(
    ["app.py"],
    pathex=[str(ROOT)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        "matplotlib", "scipy", "pandas", "notebook", "jupyter",
        "torch", "tensorflow", "transformers",
        # Windows-only modules — defensive excludes to keep the bundle clean
        "winsound", "winreg", "keyboard", "faster_whisper", "ctranslate2",
        "nvidia",
    ],
    noarchive=False,
    optimize=0,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="NoMoreWriting",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=False,           # GUI app — no terminal window
    disable_windowed_traceback=False,
    argv_emulation=False,
    # arm64 only for v4 — Pillow + several pip wheels don't ship universal2 binaries,
    # which PyInstaller --target-arch universal2 requires. Apple Silicon covers ~all
    # Macs sold since late 2020; if Intel support becomes a hard requirement we can
    # switch to a per-arch matrix build later.
    target_arch=None,
    codesign_identity=None,    # Unsigned — users right-click → Open on first launch
    entitlements_file="entitlements.plist",
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="NoMoreWriting",
)

# Wrap the COLLECT output in a proper .app bundle with Info.plist metadata.
# Without this, the binary would launch but lack the entries macOS needs to
# show a permission prompt (mic) or hide the Dock icon.
app = BUNDLE(
    coll,
    name="NoMoreWriting.app",
    icon="assets/icon.icns",
    bundle_identifier="app.alva.nomorewriting",
    version="3.0.0",
    info_plist={
        "CFBundleName": "No More Writing",
        "CFBundleDisplayName": "No More Writing",
        "CFBundleShortVersionString": "3.0.0",
        "CFBundleVersion": "3.0.0",
        "CFBundleIdentifier": "app.alva.nomorewriting",
        # Hide from Dock + Cmd-Tab — the Beam overlay is the only UI most of the time.
        # The main settings window still appears when the user opens it.
        "LSUIElement": False,  # keep dock icon for now; flip to True later if requested
        # Microphone permission prompt copy (Apple shows this verbatim).
        "NSMicrophoneUsageDescription":
            "No More Writing transcribes what you say into text. Microphone access is required for dictation.",
        # macOS uses this for the Accessibility permission prompt (which the hotkey + paste need).
        "NSAppleEventsUsageDescription":
            "No More Writing sends the system paste shortcut (Cmd+V) to whichever app you have focused.",
        "LSMinimumSystemVersion": "11.0",  # Big Sur+
        "NSHighResolutionCapable": True,
        "NSRequiresAquaSystemAppearance": False,  # supports dark mode
    },
)
